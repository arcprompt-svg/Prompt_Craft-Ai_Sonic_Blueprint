rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // -------------------------------------------------------------------------
    // GLOBAL HELPERS & PRIMITIVES
    // -------------------------------------------------------------------------
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userIdField) {
      return isSignedIn() && request.auth.uid == userIdField;
    }

    // Admin helper - only used if app has admin concept
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'arcprompt@gmail.com' && request.auth.token.email_verified == true
      );
    }

    // -------------------------------------------------------------------------
    // VALIDATION BLUEPRINTS
    // -------------------------------------------------------------------------

    function isValidPromptState(data) {
      return data.genre1 is string && data.genre1.size() <= 50 &&
             data.genre2 is string && data.genre2.size() <= 50 &&
             data.vocals is string && data.vocals.size() <= 1000 &&
             data.instruments is string && data.instruments.size() <= 1000 &&
             data.logic is string && data.logic.size() <= 2000 &&
             (!('temperature' in data) || data.temperature is number) &&
             (!('topP' in data) || data.topP is number) &&
             (!('frequencyPenalty' in data) || data.frequencyPenalty is number);
    }

    function isValidMasterPrompt(data) {
      return isValidPromptState(data) &&
             data.profile is string && data.profile.size() <= 100 &&
             data.visibility in ['public', 'private'] &&
             data.prompt is string && data.prompt.size() <= 5000 &&
             data.timestamp is string && // App uses ISOString
             data.userId == request.auth.uid;
    }

    function isValidPromptTemplate(data) {
      return isValidPromptState(data) &&
             data.name is string && data.name.size() <= 100 &&
             data.userId == request.auth.uid &&
             data.createdAt is string; // App uses ISOString
    }

    function isValidCollabSession(data) {
      return isValidPromptState(data.formState) &&
             data.lastUpdatedBy is string &&
             data.updatedAt is string;
    }

    function isValidParticipant(data) {
      return data.uid == request.auth.uid &&
             data.displayName is string && data.displayName.size() <= 100 &&
             data.photoURL is string && data.photoURL.size() <= 500 &&
             data.lastActive is string;
    }

    // -------------------------------------------------------------------------
    // ACCESS RULES
    // -------------------------------------------------------------------------

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Master Prompts
    match /master_prompts/{promptId} {
      allow get: if (existing().visibility == 'public') || isOwner(existing().userId) || isAdmin();
      allow list: if (resource.data.visibility == 'public') || isOwner(resource.data.userId) || isAdmin();
      allow create: if isVerified() && isValidMasterPrompt(incoming());
      allow update: if isVerified() && isOwner(existing().userId) && isValidMasterPrompt(incoming()) && (
        incoming().userId == existing().userId &&
        incoming().diff(existing()).affectedKeys().hasOnly(['profile', 'visibility', 'prompt', 'genre1', 'genre2', 'vocals', 'instruments', 'logic', 'temperature', 'topP', 'frequencyPenalty'])
      );
      allow delete: if isVerified() && (isOwner(existing().userId) || isAdmin());
    }

    // Prompt Templates
    match /prompt_templates/{templateId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isVerified() && isValidPromptTemplate(incoming());
      allow update: if isVerified() && isOwner(existing().userId) && isValidPromptTemplate(incoming()) && (
        incoming().userId == existing().userId &&
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'genre1', 'genre2', 'vocals', 'instruments', 'logic', 'temperature', 'topP', 'frequencyPenalty'])
      );
      allow delete: if isVerified() && (isOwner(existing().userId) || isAdmin());
    }

    // Collaboration Sessions
    match /collab_sessions/{sessionId} {
      allow read: if isSignedIn(); // Open to anyone signed in with the link
      allow create: if isVerified() && isValidCollabSession(incoming());
      allow update: if isVerified() && isValidCollabSession(incoming()) && (
        // Action: State Update
        incoming().diff(existing()).affectedKeys().hasOnly(['formState', 'lastUpdatedBy', 'updatedAt'])
      );
      allow delete: if isAdmin();
      
      // Participants Subcollection
      match /participants/{userId} {
        allow read: if isSignedIn();
        allow create, update: if isVerified() && isValidId(userId) && userId == request.auth.uid && isValidParticipant(incoming());
        allow delete: if isVerified() && (userId == request.auth.uid || isAdmin());
      }
    }
  }
}
