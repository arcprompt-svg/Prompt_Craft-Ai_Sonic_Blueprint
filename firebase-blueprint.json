{
  "entities": {
    "PromptState": {
      "title": "PromptState",
      "description": "The core state of a music prompt configuration",
      "type": "object",
      "properties": {
        "genre1": { "type": "string", "description": "The primary genre (heritage)" },
        "genre2": { "type": "string", "description": "The hybrid genre (modern mix)" },
        "vocals": { "type": "string", "description": "Vocal specification" },
        "instruments": { "type": "string", "description": "Instrument specification" },
        "logic": { "type": "string", "description": "Logic and polish keywords" },
        "temperature": { "type": "number", "description": "AI generation temperature" },
        "topP": { "type": "number", "description": "AI generation nucleus sampling top_p" },
        "frequencyPenalty": { "type": "number", "description": "AI generation frequency penalty" }
      },
      "required": ["genre1", "genre2", "vocals", "instruments", "logic"]
    },
    "MasterPrompt": {
      "title": "MasterPrompt",
      "description": "A generated and saved master prompt",
      "type": "object",
      "properties": {
        "profile": { "type": "string", "description": "Profile name" },
        "visibility": { "type": "string", "enum": ["private", "public"], "description": "Privacy setting" },
        "prompt": { "type": "string", "description": "The final generated prompt text" },
        "timestamp": { "type": "string", "format": "date-time", "description": "When it was saved" },
        "userId": { "type": "string", "description": "Owner identifier" },
        "genre1": { "type": "string" },
        "genre2": { "type": "string" },
        "vocals": { "type": "string" },
        "instruments": { "type": "string" },
        "logic": { "type": "string" },
        "temperature": { "type": "number" },
        "topP": { "type": "number" },
        "frequencyPenalty": { "type": "number" }
      },
      "required": ["profile", "visibility", "prompt", "timestamp", "userId", "genre1", "genre2", "vocals", "instruments", "logic"]
    },
    "PromptTemplate": {
      "title": "PromptTemplate",
      "description": "A re-usable template configuration",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Template name" },
        "userId": { "type": "string", "description": "Owner identifier" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" },
        "genre1": { "type": "string" },
        "genre2": { "type": "string" },
        "vocals": { "type": "string" },
        "instruments": { "type": "string" },
        "logic": { "type": "string" },
        "temperature": { "type": "number" },
        "topP": { "type": "number" },
        "frequencyPenalty": { "type": "number" }
      },
      "required": ["name", "userId", "createdAt", "genre1", "genre2", "vocals", "instruments", "logic"]
    },
    "CollabSession": {
      "title": "CollabSession",
      "description": "Active collaboration session state",
      "type": "object",
      "properties": {
        "formState": { "$ref": "#/entities/PromptState" },
        "lastUpdatedBy": { "type": "string", "description": "UID of last user to edit" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp" }
      },
      "required": ["formState", "lastUpdatedBy", "updatedAt"]
    },
    "Participant": {
      "title": "Participant",
      "description": "User in a collaboration session",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "lastActive": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "photoURL", "lastActive"]
    }
  },
  "firestore": {
    "collab_sessions/{sessionId}": {
      "schema": "CollabSession",
      "description": "Root session documents"
    },
    "collab_sessions/{sessionId}/participants/{userId}": {
      "schema": "Participant",
      "description": "Real-time presence and meta"
    },
    "master_prompts/{promptId}": {
      "schema": "MasterPrompt",
      "description": "History of output prompts"
    },
    "prompt_templates/{templateId}": {
      "schema": "PromptTemplate",
      "description": "Saved configurations/presets"
    }
  }
}
